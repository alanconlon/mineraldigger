# Optional overrides for the live Payment Links in data/stripe.json.
# Leave a line blank to keep the URL in that file.
# A non-empty https URL replaces that product's pay button at build time.
# An empty link in the file still shows Coming soon and is not a buy button.
STRIPE_FEATURED_SHOW_URL=
STRIPE_YEAR_PASS_URL=
STRIPE_SITE_SPONSOR_URL=
STRIPE_FRIDAY_EMAIL_URL=

# Optional. Cloudflare Pages function forwards submit-form JSON here.
# Leave blank until mail or a webhook is connected.
SUBMISSION_WEBHOOK_URL=

# Local server only.
PORT=4317

# Buttondown API key for the mineraldigger newsletter (https://buttondown.com/mineraldigger).
# Used only by scripts/buttondown_draft.py. Drafts only: the script does not send or schedule.
# Leave unset to dry-run. There is no BUTTONDOWN_API_KEY fallback.
MINERALDIGGER_BUTTONDOWN_API_KEY=

# Page token for the MineralDigger Facebook Page (Graph id in growth/facebook_page.json).
# Used only by scripts/facebook_post.py with --publish.
# Lookup order: this variable, then the matching page in ~/.secrets/fb_pages.json,
# then a user token named fb_user_token exchanged for this page's token.
# That user token is MINERALDIGGER_FB_USER_TOKEN, then FB_USER_TOKEN, then the
# fb_user_token key in ~/.secrets/fb_pages.json, then the file ~/.secrets/fb_user_token.
# Leave unset to dry-run. Values are never printed.
MINERALDIGGER_FB_PAGE_TOKEN=

# Optional user token. Used only when the page token above is not already set.
# Leave unset when the page token or ~/.secrets/fb_pages.json already has this Page.
MINERALDIGGER_FB_USER_TOKEN=

# App password for the Bluesky handle mineraldigger.com.
# Used only by scripts/bluesky_post.py with --publish.
# Lookup order: this variable, then the mineraldigger.com entry in ~/.secrets/bluesky.json
# (or the key mineraldigger_bluesky_app_password in that file), then the file
# ~/.secrets/mineraldigger_bluesky_app_password.
# Leave unset to dry-run. Values are never printed.
MINERALDIGGER_BLUESKY_APP_PASSWORD=
