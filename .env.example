# Paste live Stripe Payment Links here, then rebuild.
# A button switches on when the value is a non-empty https URL.
# You can instead edit data/stripe.json links. Env vars win over that file.
STRIPE_FEATURED_SHOW_URL=
STRIPE_YEAR_PASS_URL=
STRIPE_SITE_SPONSOR_URL=
STRIPE_FRIDAY_EMAIL_URL=

# Optional. Cloudflare Pages function forwards submit-form JSON here.
# Leave blank until mail or a webhook is connected.
SUBMISSION_WEBHOOK_URL=

# Local server only.
PORT=4317
